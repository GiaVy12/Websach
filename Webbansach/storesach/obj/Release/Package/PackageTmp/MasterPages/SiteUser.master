<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SiteUser.master.cs" Inherits="storesach.MasterPages.SiteUser" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <title>Kho Sách</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body>
    <form runat="server">
        <!-- HEADER -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/Users/Default.aspx">📚 Kho Sách</a>

                <!-- Nút 3 gạch khi thu nhỏ -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Thanh tìm kiếm -->
                <div class="d-flex ms-3 my-2 my-lg-0">
                    <asp:TextBox ID="txtSearchGlobal" runat="server" CssClass="form-control me-2" Placeholder="Tìm sách..." />
                    <asp:Button ID="btnSearchGlobal" runat="server" Text="🔍" CssClass="btn btn-outline-primary" OnClick="btnSearchGlobal_Click" />
                </div>

                <!-- Menu chính -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="/Users/Default.aspx">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Users/Books.aspx">Danh mục sách</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Users/About.aspx">Giới thiệu</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Users/Contact.aspx">Liên hệ</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Users/OrderHistory.aspx">Lịch sử đơn hàng</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Users/Profile.aspx">Thông tin cá nhân</a></li>
                        <li class="nav-item">
                            <asp:HyperLink ID="lnkCart" runat="server" NavigateUrl="/Users/Cart.aspx" CssClass="nav-link">
                                🛒 Giỏ hàng (<asp:Label ID="lblCartCount" runat="server" Text="0"></asp:Label>)
                            </asp:HyperLink>
                        </li>
                    </ul>

                    <!-- Đăng nhập/Đăng xuất -->
                    <span class="navbar-text ms-lg-3">
                        <asp:LoginView runat="server">
                            <AnonymousTemplate>
                                <a class="btn btn-outline-dark btn-sm" href="/Users/Login.aspx">Đăng nhập</a>
                            </AnonymousTemplate>
                            <LoggedInTemplate>
                                Xin chào, <asp:LoginName runat="server" /> |
                                <asp:LoginStatus runat="server" LogoutAction="Redirect" LogoutPageUrl="/Users/Login.aspx" CssClass="btn btn-outline-danger btn-sm" />
                            </LoggedInTemplate>
                        </asp:LoginView>
                    </span>
                </div>
            </div>
        </nav>

        <!-- MAIN -->
        <div class="container mt-4 mb-5">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

        <!-- FOOTER -->
        <footer class="bg-light text-dark pt-4 border-top">
            <div class="container">
                <div class="row">
                    <!-- Cột 1: Hỗ trợ khách hàng -->
                    <div class="col-md-4 mb-3">
                        <h6 class="fw-bold">HỖ TRỢ KHÁCH HÀNG</h6>
                        <p class="mb-1">📞 0933 109 009</p>
                        <p class="mb-1">📧 info@khosach.vn</p>
                        <p class="mb-1">🏠 9 Lý Thái Tổ, TP.HCM</p>
                    </div>

                    <!-- Cột 2: Tài khoản -->
                    <div class="col-md-4 mb-3">
                        <h6 class="fw-bold">TÀI KHOẢN CỦA BẠN</h6>
                        <ul class="list-unstyled">
                            <li><a href="/Users/Profile.aspx" class="text-decoration-none text-dark">Thông tin cá nhân</a></li>
                            <li><a href="/Users/OrderHistory.aspx" class="text-decoration-none text-dark">Lịch sử đơn hàng</a></li>
                            <li><a href="/Users/Cart.aspx" class="text-decoration-none text-dark">Giỏ hàng</a></li>
                        </ul>
                    </div>

                    <!-- Cột 3: Kết nối -->
                    <div class="col-md-4 mb-3">
                        <h6 class="fw-bold">KẾT NỐI VỚI CHÚNG TÔI</h6>
                        <a href="#" class="me-2"><i class="bi bi-facebook fs-4"></i></a>
                        <a href="#" class="me-2"><i class="bi bi-instagram fs-4"></i></a>
                        <a href="#" class="me-2"><i class="bi bi-youtube fs-4"></i></a>
                    </div>
                </div>

                <!-- Dòng cuối -->
                <div class="text-center py-3 border-top">
                    <small>&copy; 2025 - Kho Sách.</small>
                </div>
            </div>
        </footer>

    </form> 

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
