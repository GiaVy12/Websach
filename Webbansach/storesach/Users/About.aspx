<%@ Page Title="Giới thiệu" Language="C#" MasterPageFile="~/MasterPages/SiteUser.master"
    AutoEventWireup="true" CodeBehind="About.aspx.cs" Inherits="storesach.Users.About" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
    <div class="text-center mb-5">
        <h2>🌿 Về Store Sách</h2>
