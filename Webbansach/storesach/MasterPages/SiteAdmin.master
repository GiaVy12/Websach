<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SiteAdmin.master.cs" Inherits="storesach.MasterPages.SiteAdmin" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <title>Admin - Kho Sách</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <form runat="server">
        <!-- HEADER -->
        <nav class="navbar navbar-dark bg-dark shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-white" href="/Admin/Dashboard.aspx">⚙️ Admin - Kho Sách</a>
                <ul class="navbar-nav flex-row">
                    <li class="nav-item mx-2"><a class="nav-link text-white" href="/Admin/Dashboard.aspx">🏠 Dashboard</a></li>
                    <li class="nav-item mx-2"><a class="nav-link text-white" href="/Admin/Books.aspx">📚 Sách</a></li>
                    <li class="nav-item mx-2"><a class="nav-link text-white" href="/Admin/Categories.aspx">📂 Thể loại</a></li>
                    <li class="nav-item mx-2"><a class="nav-link text-white" href="/Admin/Users.aspx">👤 Người dùng</a></li>
                    <li class="nav-item mx-2"><a class="nav-link text-white" href="/Admin/Orders.aspx">🛒 Đơn hàng</a></li>
                    <li class="nav-item"><a class="nav-link text-danger fw-bold" href="../Users/Logout.aspx">🚪 Đăng xuất</a></li>
                </ul>
            </div>
        </nav>

        <!-- MAIN -->
        <div class="container mt-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>
    </form>
</body>
</html>
